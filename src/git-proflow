#!/bin/bash

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

error() {
  echo -e "${RED}Error: $1${NC}" >&2
  exit 1
}

success() {
  echo -e "${GREEN}$1${NC}"
}

warn() {
  echo -e "${YELLOW}$1${NC}"
}

# Verify we are inside a git repository
git rev-parse --is-inside-work-tree > /dev/null 2>&1 || error "Not a git repository."

# Verify the working tree is clean before any branch operation
require_clean_worktree() {
  if ! git diff --quiet || ! git diff --cached --quiet; then
    error "Working tree is not clean. Please commit or stash your changes before proceeding."
  fi
}

# Verify a branch exists locally
require_branch_exists() {
  git show-ref --verify --quiet "refs/heads/$1" || error "Branch '$1' does not exist."
}

# Verify a branch does NOT exist yet
require_branch_not_exists() {
  if git show-ref --verify --quiet "refs/heads/$1"; then
    error "Branch '$1' already exists."
  fi
}

# Safe checkout with error handling
safe_checkout() {
  git checkout "$1" > /dev/null 2>&1 || error "Failed to checkout '$1'."
}

# Safe merge with conflict detection
safe_merge() {
  local source="$1"
  local target="$2"
  if ! git merge --no-ff "$source" -m "Merged $source into $target."; then
    warn "Merge conflict detected while merging '$source' into '$target'."
    warn "Resolve the conflicts, then run 'git commit' to complete the merge."
    exit 1
  fi
}

# Safe pull with error handling
safe_pull() {
  if ! git pull > /dev/null 2>&1; then
    error "Failed to pull latest changes. Check your remote configuration."
  fi
}

# Validate that the branch name argument is provided
require_branch_name() {
  if [ -z "$1" ]; then
    error "Branch name is required.\nUsage: git proflow $2 {start|close} <branch-name>"
  fi
}

case "$1" in
"candidate")
  case "$2" in
  "start")
    require_branch_name "$3" "candidate"
    branch_name="candidate/$3"
    require_clean_worktree
    require_branch_exists "develop"
    require_branch_not_exists "$branch_name"
    safe_checkout "develop"
    safe_pull
    git checkout -b "$branch_name" || error "Failed to create branch '$branch_name'."
    success "Branch '$branch_name' created from develop."
    ;;
  "close")
    require_branch_name "$3" "candidate"
    branch_name="candidate/$3"
    require_clean_worktree
    require_branch_exists "$branch_name"
    require_branch_exists "develop"
    safe_checkout "develop"
    safe_pull
    safe_merge "$branch_name" "develop"
    git branch -d "$branch_name" || error "Failed to delete branch '$branch_name'."
    success "Branch '$branch_name' merged into develop and deleted."
    ;;
  *)
    echo "Usage: git proflow candidate {start|close} <branch-name>"
    exit 1
    ;;
  esac
  ;;
"release")
  case "$2" in
  "start")
    require_branch_name "$3" "release"
    branch_name="release/$3"
    require_clean_worktree
    require_branch_exists "develop"
    require_branch_not_exists "$branch_name"
    safe_checkout "develop"
    safe_pull
    git checkout -b "$branch_name" || error "Failed to create branch '$branch_name'."
    success "Release '$branch_name' created from develop."
    ;;
  "close")
    require_branch_name "$3" "release"
    branch_name="release/$3"
    require_clean_worktree
    require_branch_exists "$branch_name"
    require_branch_exists "develop"
    require_branch_exists "master"
    safe_checkout "develop"
    safe_pull
    safe_merge "$branch_name" "develop"
    safe_checkout "master"
    safe_pull
    safe_merge "$branch_name" "master"
    git branch -d "$branch_name" || error "Failed to delete branch '$branch_name'."
    success "Release '$branch_name' merged into develop and master, and deleted."
    ;;
  *)
    echo "Usage: git proflow release {start|close} <branch-name>"
    exit 1
    ;;
  esac
  ;;
"hotfix")
  case "$2" in
  "start")
    require_branch_name "$3" "hotfix"
    branch_name="hotfix/$3"
    require_clean_worktree
    require_branch_exists "master"
    require_branch_not_exists "$branch_name"
    safe_checkout "master"
    safe_pull
    git checkout -b "$branch_name" || error "Failed to create branch '$branch_name'."
    success "Branch '$branch_name' created from master."
    ;;
  "close")
    require_branch_name "$3" "hotfix"
    branch_name="hotfix/$3"
    require_clean_worktree
    require_branch_exists "$branch_name"
    require_branch_exists "develop"
    require_branch_exists "master"
    safe_checkout "develop"
    safe_pull
    safe_merge "$branch_name" "develop"
    safe_checkout "master"
    safe_pull
    safe_merge "$branch_name" "master"
    git branch -d "$branch_name" || error "Failed to delete branch '$branch_name'."
    success "Hotfix '$3' merged into develop and master, and deleted."
    ;;
  *)
    echo "Usage: git proflow hotfix {start|close} <branch-name>"
    exit 1
    ;;
  esac
  ;;
*)
  echo "Usage: git proflow {candidate|release|hotfix} {start|close} <branch-name>"
  exit 1
  ;;
esac
